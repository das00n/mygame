{
  "name": "jeoseunggut-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "저승굿 Prototype ①·② — headless rules engine, heuristic bot, simulators, playable Act 1 (web)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'tests/**/*.test.ts'",
    "sim:combat": "node --import tsx src/sim/combat-sim.ts",
    "sim:expedition": "node --import tsx src/sim/expedition-sim.ts",
    "sim:report": "node --import tsx src/sim/report.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:typecheck": "tsc --noEmit -p web/tsconfig.json",
    "web:build": "tsc --noEmit -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "web:artifact": "npm run web:build && node web/scripts/artifact.mjs",
    "web:e2e": "npm run web:artifact && node web/scripts/e2e.mjs",
    "web:headless": "node --import tsx web/scripts/headless.ts",
    "sim:campaign": "node --import tsx src/sim/campaign-sim.ts",
    "web:slice:dev": "vite --config web/slice/vite.config.ts",
    "web:slice": "tsc --noEmit -p web/tsconfig.json && vite build --config web/slice/vite.config.ts && node web/scripts/artifact.mjs slice",
    "web:slice:e2e": "npm run web:slice && node web/scripts/slice-e2e.mjs",
    "web:slice:bench": "node web/scripts/slice-bench.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "pixi.js": "8.22.0",
    "preact": "^11.1.1",
    "three": "0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
